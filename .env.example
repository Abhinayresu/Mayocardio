# ==============================================================================
# MayaCardio Bedside Data Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment dashboard.
# Never commit real credentials or production secret keys to version control.

# --- Edge Device Pipeline Settings ---
PIPELINE_DB_PATH=pipeline_data.db
MOCK_HOST=127.0.0.1
MOCK_PORT=7100

# Cloud Ingestion Endpoint (use public HTTPS URL when deploying)
# Local development default:
CLOUD_URL=http://127.0.0.1:8080
# Example for free cloud deployment:
# CLOUD_URL=https://mayacardio-cloud.onrender.com

# Shared API Key for edge-to-cloud authorization (Optional)
# Leave blank for local development / open access.
# Set a strong random token in production (e.g. openssl rand -hex 32).
CLOUD_API_KEY=

# --- Cloud Ingestion Server Settings ---
PORT=8080
CLOUD_DB_PATH=cloud_data.db

# In Docker container environments with persistent volume mount:
# CLOUD_DB_PATH=/data/cloud_data.db
